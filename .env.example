AEREO_MAX_FEATURES=10000
AEREO_MAX_COORDINATES=100000
AEREO_MAX_XML_ELEMENTS=200000
AEREO_MAX_CONCURRENT_UPLOADS=2
AEREO_MAX_RESULT_BYTES=33554432
